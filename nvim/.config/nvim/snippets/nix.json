{
  "dendritic-host-definition": {
    "prefix": "dendritic-host",
    "body": [
      "{ self, inputs, ... }: {",
      "  flake.nixosConfigurations.${1:machineName} = inputs.nixpkgs.lib.nixosSystem {",
      "    modules = [",
      "      self.nixosModules.${1:machineName}Configuration",
      "    ];",
      "  };",
      "}"
    ],
    "description": "dendritic-host-definition"
  },
  "dendritic-host-configuration": {
    "prefix": "dendritic-host-configuration",
    "body": [
      "{ self, inputs, ... }: {",
      "",
      "  flake.nixosModules.${1:hostName}Configuration = { pkgs, lib, ... }: {",
      "    # import any other modules from here",
      "    imports = [",
      "      self.nixosModules.${1:hostName}Hardware",
      "    ];",
      "",
      "    nix.settings.experimental-features = [ \"nix-command\" \"flakes\" ];",
      "  ",
      "    # ...any other config typically in configuration.nix",
      "  };",
      "",
      "}"
    ],
    "description": "dendritic-host-configuration"
  },
  "dendritic-feature": {
    "prefix": "dendritic-feature",
    "body": [
      "{",
      "  flake.modules.nixos.${1:module-name} = { pkgs, config, ... }: {",
      "    # add config here",
      "  };",
      "}",
      ""
    ],
    "description": "dendritic-feature"
  }
}
